#!/bin/bash
# Test arch_install.sh in a throwaway QEMU/UEFI VM.
# Usage: arch-install-test [install|boot|clean]
#   install  fresh disk, boot the Arch ISO; inside the VM run:
#            curl -o arch_install.sh http://10.0.2.2:8000/ && bash arch_install.sh
#   boot     boot the installed disk
#   clean    delete the VM files
#
# Manual equivalent:
# 1. pacman -S qemu-desktop edk2-ovmf   (or qemu-full) - UEFI firmware, arch_install.sh requires UEFI boot
# 2. Download the Arch ISO from a mirror
# 3. qemu-img create -f qcow2 disk.qcow2 40G   - throwaway virtual disk (grows on demand)
# 4. Boot the ISO in QEMU with OVMF:
#    cp /usr/share/edk2/x64/OVMF_VARS.4m.fd .
#    qemu-system-x86_64 -enable-kvm -cpu host -m 4G -smp 2 \
#        -drive if=pflash,format=raw,readonly=on,file=/usr/share/edk2/x64/OVMF_CODE.4m.fd \
#        -drive if=pflash,format=raw,file=OVMF_VARS.4m.fd \
#        -device virtio-vga-gl -display gtk,gl=on \
#        -drive file=disk.qcow2,if=virtio \
#        -cdrom archlinux-x86_64.iso -boot d
#    After install, rerun without -cdrom/-boot d to boot the installed system.
# 5. Serve arch_install.sh from the host:
#    miniserve -i 127.0.0.1 -p 8000 ~/arch_install.sh
#    then inside the VM: curl -o arch_install.sh http://10.0.2.2:8000/
# 6. Run it inside the VM against /dev/vda - nothing outside the disk image is touched.
#    NVIDIA/Bluetooth paths can't be tested in a VM.
set -e

dir=${XDG_CACHE_HOME:-$HOME/.cache}/arch-install-test
ovmf=/usr/share/edk2/x64
mirror=https://geo.mirror.pkgbuild.com/iso/latest
[[ -f $ovmf/OVMF_CODE.4m.fd ]] || { echo "needs: pacman -S qemu-desktop edk2-ovmf" >&2; exit 1; }
mkdir -p "$dir" && cd "$dir"

step() { printf '\e[1;34m:: %s\e[0m\n' "$*"; }

# UEFI VM: read-only OVMF firmware + per-VM writable vars, virtio GPU and disk
vm() {
    qemu-system-x86_64 -enable-kvm -cpu host -m 4G -smp 2 \
        -drive if=pflash,format=raw,readonly=on,file="$ovmf/OVMF_CODE.4m.fd" \
        -drive if=pflash,format=raw,file=OVMF_VARS.4m.fd \
        -device virtio-vga-gl -display gtk,gl=on \
        -drive file=disk.qcow2,if=virtio "$@"
}

case ${1:-install} in
install)
    step "1/4 Checking Arch ISO"
    sha=$(curl -fsSL "$mirror/sha256sums.txt" | awk '$2 == "archlinux-x86_64.iso" {print $1}')
    if sha256sum -c --status <<<"$sha  archlinux-x86_64.iso" 2>/dev/null; then
        echo "   up to date"
    else
        # aria2c: parallel, resumable (.aria2 control file), checksummed; no control file = stale
        [[ -f archlinux-x86_64.iso.aria2 ]] || rm -f archlinux-x86_64.iso
        aria2c -x 8 -s 8 -k 1M --file-allocation=none --checksum=sha-256="$sha" "$mirror/archlinux-x86_64.iso" ||
            { rm -f archlinux-x86_64.iso{,.aria2}; exit 1; }
    fi
    step "2/4 Creating fresh 40G disk and UEFI vars"
    rm -f disk.qcow2
    qemu-img create -q -f qcow2 disk.qcow2 40G
    cp "$ovmf/OVMF_VARS.4m.fd" .
    step "3/4 Serving arch_install.sh (host 127.0.0.1 = 10.0.2.2 in the VM)"
    miniserve -i 127.0.0.1 -p 8000 "$HOME/arch_install.sh" >/dev/null &
    trap 'kill $!' EXIT
    step "4/4 Booting ISO; this terminal waits until the VM is closed"
    printf '   %s\n' \
        'In the VM, pick "Arch Linux install medium", then run:' \
        '    curl -o arch_install.sh http://10.0.2.2:8000/ && bash arch_install.sh' \
        'Target drive: /dev/vda   Release mouse/keyboard: Ctrl+Alt+G' \
        'When done: poweroff, then: arch-install-test boot'
    vm -cdrom archlinux-x86_64.iso -boot d
    ;;
boot) step "Booting installed disk"; vm ;;
clean) step "Removing $dir"; rm -rf "$dir" ;;
*) sed -n '2,7p' "$0"; exit 1 ;;
esac
