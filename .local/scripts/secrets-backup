#!/bin/bash
# Encrypted backup of keys that can't be regenerated.
# Usage: secrets-backup [scp-dest]   (default: Shared partition)
# Restore: gpg -d secrets-*.tar.gz.gpg | tar -xzf - -C ~
set -e

paths=(.ssh .gnupg .local/share/keyrings)
dest=$1
if [[ -z "$dest" ]]; then
    part=/dev/disk/by-partlabel/Shared
    udisksctl mount -b "$part" >/dev/null 2>&1 || true
    dest=$(findmnt -no TARGET "$part")/linux-backup/
    mkdir -p "$dest"
fi
file="$(mktemp -d)/secrets-$(date +%F).tar.gz.gpg"
trap 'rm -rf "$(dirname "$file")"' EXIT

tar -czf - -C "$HOME" "${paths[@]}" | gpg --symmetric --cipher-algo AES256 -o "$file"
scp "$file" "$dest"
